# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Daily SEO article routine (server-side only, never NEXT_PUBLIC_) ---

# Google service account JSON (raw JSON, base64 JSON, or a file path) that has
# been added as a user on the Search Console property. Used by scripts/gsc-fetch.mjs.
GSC_SERVICE_ACCOUNT_JSON=

# Search Console property. Defaults to the domain property when empty.
GSC_SITE_URL=sc-domain:mengtzu.com

# xAI API key for Grok Imagine article illustrations. Used by scripts/grok-image.mjs.
XAI_API_KEY=

# Optional override; defaults to grok-imagine-image-2.0.
XAI_IMAGE_MODEL=
